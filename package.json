{
  "name": "f5-client-success",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate.mjs --test",
    "db:provision:hosted": "node scripts/provision-hosted-db.mjs",
    "db:verify:hosted": "node scripts/verify-hosted-db.mjs",
    "db:cleanup": "node scripts/cleanup-workspace.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
