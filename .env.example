# npm run db:setup generates .env.local for this project's local Docker database.
# All credentials are server-only. Never prefix them with NEXT_PUBLIC_.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# A dedicated disposable test database only. Never use the application database.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3210
